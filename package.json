{
  "name": "vampire",
  "version": "0.8.1",
  "description": "Self-hosted browser workspace for Codex, Claude Code, and persistent tmux sessions.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "vampire": "bin/vampire.js"
  },
  "files": [
    "bin",
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baealex/vampire.git"
  },
  "homepage": "https://github.com/baealex/vampire#readme",
  "bugs": {
    "url": "https://github.com/baealex/vampire/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "tmux",
    "terminal",
    "remote-development"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node runtime/dev.ts",
    "build": "vite build && node tools/build-server.ts",
    "start": "node bin/vampire.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json && tsc --project tsconfig.test.json",
    "test": "pnpm check && node --test tests/*.test.ts && pnpm build",
    "test:e2e": "pnpm build && playwright test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.26.0",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bits-ui": "^2.18.1",
    "esbuild": "^0.28.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "typescript": "^5.0.0",
    "vite": "^8.1.5"
  }
}
